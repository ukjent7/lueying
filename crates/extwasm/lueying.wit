// 掠影扩展服务缝 v2(Component Model 真契约)。
//
// 这份文件就是扩展宿主的接口契约:宿主侧绑定由 wasmtime::component::bindgen!
// 从这里生成,guest 侧绑定由 wit-bindgen 生成,服务注册表按它核对方法白名单。
// 改接口先改这里,三处生成物随编译自动更新。
//
// 服务调用是阻塞的:扩展在自己的 worker 线程上等待,宿主服务失败直接以
// result 的 Err 分支回给扩展,不会被静默吞掉。

package lueying:ext@2.0.0;

// 截取屏幕:返回临时位图文件路径,喂给 ocr.recognize 或外部命令。
interface capture {
  record region {
    x: u32,
    y: u32,
    width: u32,
    height: u32,
  }
  record shot-options {
    region: option<region>,
  }
  record shot-result {
    file: string,
    width: s64,
    height: s64,
  }
  shot: func(options: shot-options) -> result<shot-result, string>;
}

// 文字识别:输入位图文件路径,输出识别文本。
// engine 可选 `system` 或 `ppocr`;缺省跟随设置页的「截图识别」。
interface ocr {
  record recognize-options {
    file: string,
    lang: option<string>,
    engine: option<string>,
  }
  record recognize-result {
    text: string,
    lang: string,
  }
  recognize: func(options: recognize-options) -> result<recognize-result, string>;
}

// 上屏:把文本送进当前输入焦点(Unicode 注入,WM_CHAR;不依赖 TSF 会话)。
interface output {
  record deliver-options {
    text: string,
  }
  record deliver-result {
    delivered: bool,
  }
  deliver: func(options: deliver-options) -> result<deliver-result, string>;
}

// 读写剪贴板:只在扩展声明 `clipboard` 服务后可用;读到的文本可能含
// 用户敏感内容,授权页按高敏感处理。
interface clipboard {
  record read-result {
    text: string,
  }
  read: func() -> result<read-result, string>;
  record write-options {
    text: string,
  }
  write: func(options: write-options) -> result<string, string>;
  record history-options {
    limit: option<u32>,
  }
  record history-item {
    text: string,
    time: u64,
    tag: string,
  }
  record history-result {
    items: list<history-item>,
  }
  history: func(options: history-options) -> result<history-result, string>;
  record remember-options {
    text: string,
    tag: option<string>,
  }
  // 把一条文本静默收进历史,不改系统剪贴板;OCR/语音管道用。
  remember: func(options: remember-options) -> result<string, string>;
  clear: func() -> result<string, string>;
}

// 扩展私有存储:每个扩展一个命名空间,宿主只给该扩展自己的数据。
interface store {
  record get-options {
    key: string,
  }
  record get-result {
    value: option<string>,
  }
  get: func(options: get-options) -> result<get-result, string>;
  record set-options {
    key: string,
    value: string,
  }
  set: func(options: set-options) -> result<string, string>;
  record remove-options {
    key: string,
  }
  remove: func(options: remove-options) -> result<string, string>;
  record list-result {
    keys: list<string>,
  }
  list: func() -> result<list-result, string>;
}

// 宿主绘制的声明式面板:列出候选项,等用户挑选后异步返回。
interface panel {
  record show-options {
    title: string,
    items: list<string>,
  }
  record show-result {
    selected: option<u32>,
  }
  show: func(options: show-options) -> result<show-result, string>;
}

// 全局热键:注册与注销;注册冲突时返回 Err。press 等一次触发:扩展在
// async 循环里反复调用,每个热键事件兑现一次挂起的调用。
interface hotkey {
  record register-options {
    id: string,
    modifiers: list<string>,
    key: string,
  }
  register: func(options: register-options) -> result<string, string>;
  record unregister-options {
    id: string,
  }
  unregister: func(options: unregister-options) -> result<string, string>;
  record press-options {
    id: string,
  }
  press: func(options: press-options) -> result<string, string>;
}

// 系统通知。
interface notify {
  record show-options {
    title: string,
    body: string,
  }
  show: func(options: show-options) -> result<string, string>;
}

// 联网:经独立 broker 进程发 HTTPS 请求;域名必须在清单 network.allow
// 白名单里,宿主逐请求强制。响应体按文本处理,超限与超时在 broker 侧兜底。
interface network {
  record fetch-options {
    url: string,
    method: option<string>,
    headers: list<tuple<string, string>>,
    body: option<string>,
    // 响应体上限(字节),缺省 2 MiB;时限(毫秒),缺省 30 s。
    limit: option<u64>,
    timeout-ms: option<u32>,
  }
  record fetch-result {
    status: u32,
    body: string,
  }
  fetch: func(options: fetch-options) -> result<fetch-result, string>;
}

// 上下文:读当前窗口里用户选中的文字。每级单独同意,扩展清单要在
// capabilities 里申请 selected-text 才会放行。
interface context {
  record selection-result {
    text: string,
  }
  selection: func() -> result<selection-result, string>;
}

// 录音:返回临时 WAV 文件路径与时长。
interface audio {
  record record-options {
    seconds: option<u32>,
  }
  record record-result {
    file: string,
    seconds: u32,
  }
  record: func(options: record-options) -> result<record-result, string>;
}

// 离线语音识别:输入 WAV 文件路径,输出文字。
interface asr {
  record recognize-options {
    file: string,
  }
  record recognize-result {
    text: string,
  }
  recognize: func(options: recognize-options) -> result<recognize-result, string>;
}

// 扩展的导出面:init 加载时调用一次;command 按清单声明的命令 id 分发;
// appearance 只在清单 `appearance: true` 时被派发。
interface entry {
  init: func() -> result<_, string>;
  command: func(id: string, args: string) -> result<string, string>;
  appearance: func(scene-json: string) -> result<option<string>, string>;
}

world extension {
  import capture;
  import ocr;
  import clipboard;
  import store;
  import output;
  import panel;
  import hotkey;
  import notify;
  import network;
  import context;
  import audio;
  import asr;
  export entry;
}
